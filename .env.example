# Sao chép thành .env.local (chạy máy) hoặc khai báo trong Vercel → Settings → Environment Variables.
# CHỈ dùng khóa công khai (publishable/anon). KHÔNG BAO GIỜ đặt service_role key vào đây hoặc vào mã phía trình duyệt.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ma-du-an>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (Dự án Supabase cũ dùng anon key thì đặt biến này thay cho dòng trên)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Địa chỉ ứng dụng (dùng cho link chuyển hướng sau đăng nhập Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
